+def _wdemean(v, w, inv, counts):
+    """v minus its group mean; the mean is weighted by w when given (None: the plain mean, as _demean)."""
+    if w is None:
+        return _demean(v, None, inv, counts)
+    return v - (np.bincount(inv, weights=w * v, minlength=len(counts))
+                / np.bincount(inv, weights=w, minlength=len(counts)))[inv]
+
+
+def _fit_weights(smp, N):
+    """(weights for the fit, N): None and N unchanged without weights. Otherwise the weights as regress uses them
+    (a- and pweights scaled to sum to the sample size, N unchanged; fweights as they are, N their sum)."""
+    if smp.w is None:
+        return None, N
+    w, n_rep = smp.weights_for_fit()
+    return w, (int(round(n_rep)) if smp.wtype == "fweight" else N)
+
+
+def _require_constant_weights(w, inv, counts):
+    """[XT] xtreg: "Weights must be constant within panel." (checked in the Stata 14 manual; the return code is a guess)."""
+    if w is None:
+        return
+    lo = np.full(len(counts), np.inf)
+    hi = np.full(len(counts), -np.inf)
+    np.minimum.at(lo, inv, w)
+    np.maximum.at(hi, inv, w)
+    if np.any(hi - lo > 1e-9 * np.maximum(hi, 1e-300)):
+        raise StataError(101, "weights must be constant within panel")   # VERIFY the return code and the text
+
+
