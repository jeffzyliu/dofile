+def _sort_keys(sort_idx, names, K):
+    """The variables the data are sorted by. The list ends at the first 0: Stata leaves other bytes after it (ODT-25)."""
+    keys = []
+    for k in sort_idx:
+        if k == 0:
+            break
+        if k <= K:
+            keys.append(names[k - 1])
+    return keys
