language js(jsx)

// The architecture rules that read code, not text: a Biome plugin, one diagnostic per match. Which files each rule
// covers is the regex on $filename. A rule that breaks fails npm run check and lint:strict: fix the code, unless the
// rule has changed (web/CLAUDE.md, "Architecture rules").

// A default import (import x from "...") is not matched: the pattern also takes "import type" lines, and no module in
// src/ has a default export, so tsc catches it.
pattern value_import($source) {
  or {
    `import { $_ } from $source`,
    `import * as $_ from $source`,
    `import $source`,
    `export { $_ } from $source`
  }
}

or {
  // No cast round the Ticket brand: only machine.ts makes a ticket (its one cast is counted by test/imports.test.ts).
  `$_ as $type` as $m where {
    $type <: or {
      `any`,
      `never`
    },
    $filename <: r".*/(?:src/.*|test/machine\.test\.ts)$",
    register_diagnostic(span=$m, message="no cast to any or never in src/ or the machine's test: a Ticket is made only in machine.ts")
  },
  // machine.ts is pure: type imports only, no random number (the clock, timers and console are noRestrictedGlobals).
  value_import($source) as $m where {
    $filename <: r".*/src/engine/machine\.ts$",
    register_diagnostic(span=$m, message="machine.ts imports types only")
  },
  `Math.random` as $m where {
    $filename <: r".*/src/engine/machine\.ts$",
    register_diagnostic(span=$m, message="machine.ts is pure: no random number")
  },
  // The page's code takes only types from the transport: it never calls it, nor imports the Worker's entry.
  value_import($source) as $m where {
    $filename <: r".*/src/app/.*",
    $source <: r".*engine/(?:client|worker).*",
    register_diagnostic(span=$m, message="src/app/ takes only types from the transport (import type)")
  },
  // Only main.tsx makes the transport and the Worker, connects the controllers, takes the tab lock and calls open().
  or {
    `new EngineClient($_)`,
    `new Worker($_)`,
    `connectEngine($_)`,
    `connectFiles($_)`,
    `connectRun($_)`,
    `tabLock($_)`,
    `open()`
  } as $m where {
    $filename <: r".*/src/.*",
    $filename <: not r".*/src/main\.tsx$",
    register_diagnostic(span=$m, message="only src/main.tsx constructs the transport and the Worker, connects the controllers, takes the tab lock and calls open()")
  },
  // The store is opened once on each thread: in the page's store.ts and on the Worker's side (worker*.ts).
  `openStore($_)` as $m where {
    $filename <: r".*/src/.*",
    $filename <: not r".*/src/(?:engine/worker[^/]*|app/store\.ts)$",
    register_diagnostic(span=$m, message="openStore() is called only in src/app/store.ts (the page) and src/engine/worker*.ts (the Worker)")
  },
  // Events enter the machine in one place: the controller calls transition() and initial().
  or {
    `transition($_)`,
    `initial($_)`
  } as $m where {
    $filename <: r".*/src/.*",
    $filename <: not r".*/src/(?:app/engine\.ts|engine/machine\.ts)$",
    register_diagnostic(span=$m, message="only the engine controller (src/app/engine.ts) calls transition() and initial()")
  },
  // Each signal has one writer: a writer object is named only by state.ts and its owner.
  or {
    `engineWriter`,
    `graphicsWriter`
  } as $m where {
    $filename <: r".*/src/.*",
    $filename <: not r".*/src/app/(?:state/engine|engine)\.ts$",
    register_diagnostic(span=$m, message="engineWriter and graphicsWriter are named only by state/engine.ts and app/engine.ts")
  },
  `runWriter` as $m where {
    $filename <: r".*/src/.*",
    $filename <: not r".*/src/app/(?:state|run)\.ts$",
    register_diagnostic(span=$m, message="runWriter is named only by state.ts and app/run.ts")
  },
  `filesWriter` as $m where {
    $filename <: r".*/src/.*",
    $filename <: not r".*/src/app/(?:state/files|files)\.ts$",
    register_diagnostic(span=$m, message="filesWriter is named only by state/files.ts and app/files.ts")
  },
  // The controller's queue has one way in: enqueue(), called from dispatch() and reply() only; nothing else puts an
  // event into the queue or empties it, but connectEngine().
  `enqueue($_)` as $m where {
    $filename <: r".*/src/app/engine\.ts$",
    $m <: not within JsFunctionDeclaration(id=`dispatch`),
    $m <: not within `const reply = $_`,
    register_diagnostic(span=$m, message="enqueue() is called only in dispatch() and reply()")
  },
  or {
    `queue.push($_)`,
    `queue.unshift($_)`,
    `queue.splice($_)`,
    `queue[$_] = $_`
  } as $m where {
    $filename <: r".*/src/app/engine\.ts$",
    $m <: not within JsFunctionDeclaration(id=`enqueue`),
    register_diagnostic(span=$m, message="the queue is pushed to only in enqueue()")
  },
  // The controller's reply() answers with the ticket of its own effect, and the engine signal is written from view().
  `$_ as $t` as $m where {
    $filename <: r".*/src/app/engine\.ts$",
    $m <: within `const reply = $_`,
    register_diagnostic(span=$m, message="reply() has no cast: it answers with a typed event")
  },
  `enqueue($e)` as $m where {
    $filename <: r".*/src/app/engine\.ts$",
    $m <: within `const reply = $_`,
    $e <: not `{ ...said, n: effect.n }`,
    register_diagnostic(span=$m, message="reply() puts its own effect's ticket on the event: enqueue({ ...said, n: effect.n })")
  },
  `engineWriter.engine.value = $v` as $m where {
    $v <: not `view($_)`,
    register_diagnostic(span=$m, message="the engine signal is written with view(state), the machine's state")
  },
  `queue = $_` as $m where {
    $filename <: r".*/src/app/engine\.ts$",
    $m <: not within JsFunctionDeclaration(id=`connectEngine`),
    register_diagnostic(span=$m, message="the queue is emptied only in connectEngine()")
  },
  // The Worker is posted to in one place: EngineClient's #send.
  `$_.postMessage($_)` as $m where {
    $filename <: r".*/src/engine/.*",
    $filename <: not r".*/src/engine/worker\.ts$",
    $m <: not within JsMethodClassMember(name=`#send`),
    register_diagnostic(span=$m, message="the page posts to the Worker only in #send")
  },
  // One door for the page's file changes: in src/app/ the store is written only through a turn's Io (files/turns.ts), so
  // each write is ordered with the tabs that follow it.
  // test/imports.test.ts keeps the store under its own name in src/app/ (no renamed import, copy or destructuring).
  or {
    JsStaticMemberExpression(),
    JsComputedMemberExpression()
  } as $m where {
    $m <: or {
      r"store\s*!?\s*\??\.\s*(?:write|mkdir|rename|remove|change|applyRun)",
      r"store\s*!?\s*(?:\?\.)?\s*\[(?s).*"
    },
    $filename <: r".*/src/app/.*",
    $filename <: not r".*/src/app/files/turns\.ts$",
    or {
      $m <: contains or {
        `write`,
        `mkdir`,
        `rename`,
        `remove`,
        `change`,
        `applyRun`
      },
      $m <: r"store\W*\[.*"
    },
    register_diagnostic(span=$m, message="the page writes the store only through a turn's Io (files/turns.ts fileTurn)")
  },
  // The turns' store is set only where files.ts is connected (connectFiles).
  `turnsOn($_)` as $m where {
    $filename <: r".*/src/.*",
    $filename <: not r".*/src/app/files\.ts$",
    register_diagnostic(span=$m, message="only connectFiles (src/app/files.ts) sets the turns' store: turnsOn()")
  },
  // A focus move or a store write is not made from a timer's callback: the e2e helper settle(page) waits for tasks,
  // microtasks, effects and frames, not for a timer of more than about 50 ms (a requestAnimationFrame is allowed).
  or {
    `$_.focus()`,
    `$_.focus($_)`,
    `$_?.focus()`,
    `$_?.focus($_)`,
    `store.write($_)`,
    `store.mkdir($_)`,
    `store.rename($_)`,
    `store.remove($_)`,
    `store.change($_)`,
    `store.applyRun($_)`
  } as $m where {
    $filename <: r".*/src/app/.*",
    $m <: within or {
      `setTimeout($_)`,
      `setInterval($_)`
    },
    register_diagnostic(span=$m, message="no focus move or store write inside a setTimeout or setInterval callback in src/app/ (e2e settle() does not wait for a timer): use a microtask, an effect or a frame")
  },
  // Every button that Start engine turns into Run keeps ignoring a held Enter: one that is aria-disabled (never
  // disabled, so it keeps the focus) in the run controls, the command line and the log; and the phone's Break pill,
  // which takes the Run button's place.
  `<button $props>$_</button>` as $m where {
    $filename <: r".*/src/app/(?:editor|log)/.*",
    $props <: or {
      contains `aria-disabled={$_}`,
      contains `class={$c}` where $c <: r".*pill.*"
    },
    $props <: not contains `onKeyDown={ignoreHeldEnter}`,
    register_diagnostic(span=$m, message="a Run or Break pill button (aria-disabled, or .pill) in editor/ or log/ ignores a held Enter: onKeyDown={ignoreHeldEnter}")
  },
  // A function, method or arrow whose return type is written Promise<...> is async. Syntactic only: an inferred
  // return type is not seen. A text test on the node finds the keyword, with or without class modifiers before it.
  or {
    JsFunctionDeclaration(return_type_annotation=TsReturnTypeAnnotation(ty=TsReferenceType(name=`Promise`))),
    JsFunctionExpression(return_type_annotation=TsReturnTypeAnnotation(ty=TsReferenceType(name=`Promise`))),
    JsArrowFunctionExpression(return_type_annotation=TsReturnTypeAnnotation(ty=TsReferenceType(name=`Promise`))),
    JsMethodClassMember(return_type_annotation=TsReturnTypeAnnotation(ty=TsReferenceType(name=`Promise`))),
    JsMethodObjectMember(return_type_annotation=TsReturnTypeAnnotation(ty=TsReferenceType(name=`Promise`)))
  } as $m where {
    $m <: not r"(?s)^(?:(?:static|public|private|protected|override)\s+)*async\b.*",
    register_diagnostic(span=$m, message="a function with a Promise<...> return type is async: add async. Where it must not be (it returns one cached promise each time, a promise-like object with more methods, or throws synchronously on purpose), put // biome-ignore lint/plugin: <reason> above it")
  }
}
